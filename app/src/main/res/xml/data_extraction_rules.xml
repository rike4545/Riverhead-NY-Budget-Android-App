<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing this app stores is backed up or copied to a new device: it keeps
  only cached public data, favorites and display settings, which it rebuilds
  or the user resets in seconds. On Android 12+ allowBackup="false" still
  allows device-to-device transfer, so both are excluded explicitly here.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
